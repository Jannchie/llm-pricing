{
  "name": "llm-pricing",
  "type": "module",
  "version": "0.2.0",
  "description": "Time-aware LLM token pricing: resolve a model name to a rate card and turn token counts into USD.",
  "author": "Jannchie",
  "license": "MIT",
  "homepage": "https://github.com/Jannchie/llm-pricing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/llm-pricing.git"
  },
  "bugs": {
    "url": "https://github.com/Jannchie/llm-pricing/issues"
  },
  "keywords": [
    "llm",
    "pricing",
    "cost",
    "tokens",
    "openrouter",
    "models.dev",
    "anthropic",
    "openai",
    "deepseek"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "sync": "node scripts/sync-snapshot.mjs",
    "check:live": "vite-node scripts/check-live-prices.ts",
    "example": "vite-node examples/tour.ts"
  },
  "devDependencies": {
    "@jannchie/eslint-config": "^3.7.9",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
